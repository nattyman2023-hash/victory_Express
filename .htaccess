Options -Indexes -MultiViews
DirectoryIndex main.php index.php
FileETag None

RewriteEngine On
RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ main.php [QSA,L]

<FilesMatch "^(config.*|\.env|.*\.sql)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(?:includes|database)/

<FilesMatch "\.(zip|docx)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/stitch_victory_express_trading_website/

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|jpg|jpeg|png|webp|svg|woff2)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
